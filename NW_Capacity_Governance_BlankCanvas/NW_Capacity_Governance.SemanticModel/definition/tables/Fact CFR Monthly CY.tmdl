table 'Fact CFR Monthly CY'
	lineageTag: 698ec3cb-054d-4de9-b95d-68596a0ed990

	measure 'CFR % Monthly CY' = BLANK()
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3d1b73db-1969-4645-9b64-37c004cb2b55

	measure 'Cases per Order Monthly CY' = BLANK()
		formatString: 0
		lineageTag: 3f53b451-5be0-4460-9a31-9ac6e84f04c0

	measure '# Orders Monthly CY' = BLANK()
		formatString: 0
		lineageTag: 10e71f33-078e-4a9c-bd60-3aec3ed49891

	measure 'Cases per Order Monthly Target' = 10
		formatString: 0
		lineageTag: c891b461-452d-44cd-acf4-44c22b5d6543

	measure Target_test = ([Utilization Target] + [CFR Target] + [Revenue Target Monthly] + [GP Dead Net %] )
		lineageTag: a2ac4b11-2b6b-450d-9e09-7d2277b0bf11

	measure 'Previous Year' = ([CFR % Monthly PY] + 'Fact Utilization PY Monthly'[Utilization @Branch PY Monthly] + [Revenue PY Monthly] + [Gross Profit % Monthly])
		lineageTag: 3acd594e-29f9-4d53-bbef-7ed76a0e7b61

	measure 'CFR Ref Monthly' = IF([Ref 1] = "Target",[CFR Target],[CFR % Monthly PY])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d8a59768-1c59-4c24-bc61-89730223411b

	measure 'CFR Ref Daily' = BLANK()
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1364d521-f404-48c6-a235-08478d9e1919

