	measure 'Pallet holding Capacity P' = SUM('Fact Inventory Period'[PalletHoldingCapacity])
		lineageTag: 593b41ee-0e34-4681-bb48-8ab8945f9eab

	measure 'K-Max Holding capacity P' = [K-Max Delta Pallets M P]/[Average Pallet Holding Capacity CY]
		formatString: 0%;-0%;0%
		lineageTag: 22291aa5-f17e-485f-884b-9ac5830720ea

	measure 'Pallets within ​Desired Range' = CALCULATE(divide(sum('Fact Inventory Period'[CurrentPallets]),[# Days]), 'Fact Inventory Period'[InventoryStatusPallets]="Within Limits")
		formatString: 0
		lineageTag: b819c267-d7ed-4242-a965-ee5b52224874

	measure 'Percentage of K-max pallets' = [K-Max Delta Pallets M P]/[Pallet Holding Capacity M]
		formatString: 0%;-0%;0%
		lineageTag: c0cb5d6c-2007-4af9-a597-c1a916878f33

	measure 'K-Min Holding capacity P' = [K-Min Delta Pallets M P]/[Average Pallet Holding Capacity CY]
