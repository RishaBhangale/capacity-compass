	measure 'Current pallets Inv.' = SUM('Fact Inventory Period'[CurrentPallets])
		lineageTag: c5ffde1d-c9c2-4ff5-a4a6-1523cdae1ca3

	measure 'Excess pallets agn. 85%' = CALCULATE(([Average Current Pallets CY] - [Average Pallet Holding Capacity CY] * 0.85) )
		lineageTag: 82d9d7d7-ee09-4a1e-9698-de760465e6af

	measure 'Color Inventory Status Icon' = BLANK()
