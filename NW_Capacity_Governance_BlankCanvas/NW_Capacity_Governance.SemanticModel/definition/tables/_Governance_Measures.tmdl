		lineageTag: afe00f3b-e9d8-4b7b-b590-df048aa39c15

	measure 'Fields Per Page' = DIVIDE(COUNTROWS(_Gov_ReportUsage), DISTINCTCOUNT(_Gov_ReportUsage[Page]), 0)
		formatString: #,0.0
		displayFolder: 00 Governance KPIs
		lineageTag: 58f286cf-3f3c-43fe-9231-412c5bcd4a06

	measure 'Selected Table' = SELECTEDVALUE(_Gov_FieldSummary[Table], "All Tables")
		displayFolder: 00 Governance KPIs
		lineageTag: 168c8a4f-f563-4c8b-b8d3-5b4b54f6e512

	measure 'Health Color' = SWITCH(TRUE(), [Model Health Score] >= 75, "#217346", [Model Health Score] >= 50, "#E8701A", "#C00000")
		displayFolder: 00 Governance KPIs
		lineageTag: 71eb81ee-6a07-4277-a5b5-e46ff0366a04

	measure 'Adoption Tier Summary' = VAR H = CALCULATE(COUNTROWS(_Gov_FieldSummary),_Gov_FieldSummary[AdoptionTier]="High") VAR M = CALCULATE(COUNTROWS(_Gov_FieldSummary),_Gov_FieldSummary[AdoptionTier]="Medium") VAR L = CALCULATE(COUNTROWS(_Gov_FieldSummary),_Gov_FieldSummary[AdoptionTier]="Low") VAR U = [Never Used Fields] RETURN "High: "&H&"  Med: "&M&"  Low: "&L&"  Unused: "&U
		displayFolder: 00 Governance KPIs
		lineageTag: 3bbe7bab-fbb9-4b08-b06b-ff833eedb1af

	measure 'Active Fields' = CALCULATE(COUNTROWS(_Gov_FieldSummary), _Gov_FieldSummary[NeverUsed]="No")
