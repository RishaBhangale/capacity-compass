		lineageTag: fe5baaae-149d-40c2-9ef6-b31d2206248a

	measure 'Governance Risk Score' = VAR OrphanRisk = MIN(DIVIDE([Orphaned References],198,0)*40,40) VAR UnusedRisk = MIN(DIVIDE([Never Used Fields],1039,0)*40,40) VAR M2M = [Many-to-Many Relationships]*5 RETURN ROUND(MIN(OrphanRisk+UnusedRisk+M2M,100),0)
		formatString: #,0
		displayFolder: 01 Executive
		lineageTag: 2a1d6641-abdd-40e4-870f-0bdc190fb431

	measure 'OneDirection Rels' = CALCULATE(COUNTROWS(_Gov_Relationships), _Gov_Relationships[CrossFilterDir]="oneDirection")
