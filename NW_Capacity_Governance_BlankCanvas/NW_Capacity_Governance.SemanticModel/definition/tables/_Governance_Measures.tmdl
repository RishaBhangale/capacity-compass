table _Governance_Measures
	isHidden
	lineageTag: 69a4c06f-a044-4677-85a0-e9cbd44a8d12

	measure 'Total Model Tables' = COUNTROWS(_Gov_FieldSummary)
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: a4912af6-0e9a-4f6c-81cb-8389d0e127e9

	measure 'Total Measures' = CALCULATE(COUNTROWS(_Gov_FieldSummary), _Gov_FieldSummary[FieldType] = "Measure")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 1d18f82a-e1f1-4c85-8895-51df490b68c7

	measure 'Total Columns' = CALCULATE(COUNTROWS(_Gov_FieldSummary), _Gov_FieldSummary[FieldType] = "Column (data)")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 6a524d6d-9083-41c9-9844-dd56f1765876

	measure 'Total Relationships' = COUNTROWS(_Gov_Relationships)
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 40da2ba2-cef9-4058-af48-1fbc5350529f

	measure 'Total Report Pages' = DISTINCTCOUNT(_Gov_ReportUsage[Page])
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: cbdf3a1a-de0b-4866-9f64-9fd605d327fe

	measure 'Total Field References' = COUNTROWS(_Gov_ReportUsage)
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 8328e71e-8faa-4e32-b47d-0149d95ca1c2

	measure 'Unique Fields Used' = DISTINCTCOUNT(_Gov_ReportUsage[FullName])
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 3048a9d1-457f-46f8-8e76-d5e1e2103c02

	measure 'Never Used Fields' = CALCULATE(COUNTROWS(_Gov_FieldSummary), _Gov_FieldSummary[NeverUsed] = "Yes")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: e5ebaef7-677d-4a34-928d-71c1fdcbeea7

	measure 'Unused Fields %' = DIVIDE([Never Used Fields], COUNTROWS(_Gov_FieldSummary), 0)
		formatString: 0.0%
		displayFolder: 00 Governance KPIs
		lineageTag: f3c056c0-b87e-4d0c-9da4-a8d74dcf86d0

	measure 'Orphaned References' = COUNTROWS(_Gov_Orphans)
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 2397bd62-942f-439e-a65f-f0b65b300aa9

	measure 'High Risk Orphans' = CALCULATE(COUNTROWS(_Gov_Orphans), _Gov_Orphans[RiskLevel] = "High")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: f5879c03-0921-4ce8-b5b7-9ab55782553b

	measure 'Field Utilisation %' = DIVIDE([Unique Fields Used], COUNTROWS(_Gov_FieldSummary), 0)
		formatString: 0.0%
		displayFolder: 00 Governance KPIs
		lineageTag: 1681f4ed-9aee-4547-b910-b45136be46d0

	measure 'Visual Field Usage' = CALCULATE(COUNTROWS(_Gov_ReportUsage), _Gov_ReportUsage[UsageContext] = "Visual Field", _Gov_ReportUsage[IsHiddenVisual] = "No")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: cc56e37b-4566-489f-a645-8f64642b456e

	measure 'Slicer Usage Count' = CALCULATE(COUNTROWS(_Gov_ReportUsage), _Gov_ReportUsage[UsageContext] = "Slicer")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: c55cd3ce-a89b-4cc5-9943-d0eccebf52c4

	measure 'Model Health Score' = VAR TotalFields = COUNTROWS(_Gov_FieldSummary) VAR UnusedPct = DIVIDE([Never Used Fields], TotalFields, 0) VAR OrphanPenalty = MIN(DIVIDE([Orphaned References], 50, 0) * 30, 30) RETURN ROUND(MAX(0, 100 - UnusedPct * 40 - OrphanPenalty), 0)
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 213bd77d-b0f2-4e5d-bea4-ce8fc7e22fd4

	measure 'Many-to-Many Relationships' = CALCULATE(COUNTROWS(_Gov_Relationships), _Gov_Relationships[FromCardinality]="many", _Gov_Relationships[ToCardinality]="many")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: ef2f86e0-125e-4897-b4e3-fcd7645d9a59

	measure 'Snowflake Tables' = CALCULATE(COUNTROWS(_Gov_PQSources), _Gov_PQSources[Connector]="Snowflake")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 2db8df55-629a-4ef4-adf3-3cd9ff3a9a9d

	measure 'CSV Tables' = CALCULATE(COUNTROWS(_Gov_PQSources), _Gov_PQSources[Connector]="CSV File")
		formatString: #,0
		displayFolder: 00 Governance KPIs
		lineageTag: 9beff3df-c842-4072-9ae8-3b07cd1a115a

	measure 'SharePoint Tables' = CALCULATE(COUNTROWS(_Gov_PQSources), _Gov_PQSources[Connector]="SharePoint")
